# =====================================================================
# Contract-IQ - .gitignore
# =====================================================================

# ---- Python virtual environment ----
venv/
env/
ENV/
.venv/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ---- Test / coverage / caches ----
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---- IDE / OS ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Secrets ----
.env
.env.local
.env.*.local
!.env.example

# ---- Runtime application data ----
# Uploaded originals + generated markdown (the API stores these here)
tempfolder/
tmp/

# ---- Database ----
# SQLite database files. data/contracts.db is auto-created on first run.
data/*.db
data/*.db-journal
data/*.sqlite
data/*.sqlite3

# ---- Reports / lock files / logs ----
CIQ_API_TEST_REPORT.docx
~$*.docx
*.log
logs/

# ---- Temporary files ----
*.tmp
*.temp